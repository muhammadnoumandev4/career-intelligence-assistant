# Career Intelligence Assistant — environment
#
# The app runs with ZERO secrets in deterministic mode. Add keys below only to
# enable the LLM pipeline (embeddings + Claude generation). Nothing here is
# required for the local demo.

# Enables Claude generation + hybrid retrieval (switches mode to "llm").
ANTHROPIC_API_KEY=

# Optional: enables OpenAI embeddings for dense/hybrid retrieval.
# Without it, the llm pipeline falls back to lexical retrieval.
OPENAI_API_KEY=

# Optional overrides.
CHAT_MODEL=claude-3-5-sonnet-latest
EMBEDDING_MODEL=text-embedding-3-small
