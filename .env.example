# Career Intelligence Assistant — environment
#
# The app runs with ZERO secrets in deterministic mode. Add keys below only to
# enable the LLM pipeline (embeddings + LLM generation). Nothing here is
# required for the local demo.

# Generation is provider-agnostic — set ANY ONE of these to switch to "llm" mode.
# If several are set, precedence is Anthropic > OpenAI > Google.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Embeddings (hybrid vector + lexical retrieval) are also provider-agnostic:
# they use OPENAI_API_KEY if set, otherwise the Gemini key (gemini-embedding-001).
# With neither, the llm pipeline still works using lexical retrieval only.
# Generation and embeddings resolve independently, so they can use different
# vendors at the same time (e.g. Claude generation + OpenAI embeddings).

# Optional overrides. Defaults by provider:
#   chat:      claude-3-5-sonnet-latest / gpt-4o-mini / gemini-flash-latest
#   embedding: text-embedding-3-small (OpenAI) / gemini-embedding-001 (Google)
CHAT_MODEL=
EMBEDDING_MODEL=
